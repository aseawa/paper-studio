{
  "name": "paper-studio",
  "version": "2.0.1",
  "description": "A PDF study workspace with handwriting, page timing and portable exports.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "aseawa",
  "repository": {
    "type": "git",
    "url": "https://github.com/aseawa/paper-studio.git"
  },
  "homepage": "https://aseawa.github.io/paper-studio/",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/copy-pdf-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "node scripts/copy-pdf-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "format": "prettier --write src tests scripts *.json *.ts *.md .github"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.1.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "fake-indexeddb": "6.2.8",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
